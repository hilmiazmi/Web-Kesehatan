{
  "name": "web-kesehatan",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "bun run lint && bun run test && bun run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run scripts/db-seed.ts",
    "seed:ekstrak": "bun run scripts/seed-ekstrak.ts",
    "db:status": "bun run scripts/db-status.ts",
    "db:snapshot": "bun run scripts/db-snapshot.ts",
    "cek:konten": "bun run scripts/cek-konten.ts",
    "cek:tautan": "bun run scripts/cek-tautan.ts",
    "cek:tulis": "bun run scripts/cek-tulis.ts",
    "cek:admin": "bun run scripts/cek-admin.ts",
    "audit:teks": "bun run scripts/audit-teks.ts",
    "subset-ikon": "bun run scripts/subset-ikon.ts"
  },
  "dependencies": {
    "bootstrap": "5.3.3",
    "bootstrap-icons": "^1.13.1",
    "drizzle-orm": "^0.45.3",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sweetalert2": "11.22.4",
    "swiper": "11.2.6"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "sass": "^1.105.1",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "bun@1.4.2",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
