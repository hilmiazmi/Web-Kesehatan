# Environment variables untuk backend (Bun + Next.js).
#
# Salin ke `.env.local` di root repo, lalu isikan `AUTH_SECRET`.
#
# Nama variabel di sini sama persis dengan yang dibaca `src/server/config.ts`.
# Kalau ada yang tidak cocok, server akan memakai nilai bawaannya tanpa
# memberi tahu. Periksa dengan `bun run db:status`.

# --- Database --------------------------------------------------------------
# Kosong berarti mode snapshot: tidak ada koneksi database, dan hanya endpoint
# baca yang menjawab, dari berkas JSON di snapshot/.
#
# Lokal: postgres://postgres@127.0.0.1:5432/rsud_contoh_sehat
DATABASE_URL=

# Jumlah koneksi PostgreSQL maksimum. Bawaan 10.
#
# Sengaja kecil: VPS ini punya RAM terbatas, dan aplikasi ini satu-satunya klien
# database. Menaikkan angka ini hanya menambah risiko kehabisan memori tanpa
# menambah throughput.
DB_MAX_CONNECTIONS=10

# Berapa lama menunggu koneksi tersedia, dalam detik. Bawaan 8.
DB_ACQUIRE_TIMEOUT_SECONDS=8

# --- Sesi admin -----------------------------------------------------------
# Penandatangan cookie sesi memakai HMAC-SHA256. Wajib 32 karakter atau lebih.
# Buat nilai acak: openssl rand -base64 48
AUTH_SECRET=

# Umur maksimum sesi dalam detik. Bawaan 28800 (delapan jam, satu shift kerja).
SESSION_MAX_AGE_SECONDS=28800

# Origin yang boleh memanggil endpoint admin. Dipakai untuk CORS dan untuk
# menentukan apakah cookie sesi diberi atribut `Secure`.
ADMIN_ORIGIN=http://localhost:3000

# --- Batas permintaan -----------------------------------------------------
# Batas ukuran body JSON dalam byte. Bawaan 262144 (256 KiB).
#
# 256 KiB cukup untuk form tercepat, registrasi MCU dengan 50 peserta, dan
# cukup kecil supaya satu permintaan tidak bisa menahan memori.
BODY_LIMIT_BYTES=262144

# Rentang hari untuk kunjungan yang boleh dipilih. Bawaan 0 sampai 90.
MIN_LEAD_DAYS=0
MAX_LEAD_DAYS=90

# --- Rate limit -----------------------------------------------------------
# Jumlah permintaan per jendela waktu, per alamat IP dan per endpoint, untuk
# endpoint tulis. Bawaan 5 per 60 detik.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5

# --- Seed -----------------------------------------------------------------
# Dipakai `bun run db:seed` untuk membuat akun admin pertama. Ganti kata
# sandinya setelah seed pertama.
SEED_ADMIN_EMAIL=admin@contoh-sehat.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator Demo

# --- Mode -----------------------------------------------------------------
# `live` membaca dan menulis ke database. `snapshot` hanya membaca berkas JSON
# di `snapshot/` dan menolak semua permintaan yang mengubah data; dipakai untuk
# pratinjau di Vercel yang tidak boleh menyentuh database produksi.
API_MODE=live
