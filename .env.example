# --- Database (PRD bagian 10.1) -------------------------------------------
# Wajib diisi untuk menjalankan migrasi, seed, dan panel admin.
# Di development lokal: docker compose up -d postgres
DATABASE_URL=postgresql://rsud:rsud_dev_password@localhost:5432/rsud_contoh_sehat

# --- Auth admin ------------------------------------------------------------
# Penandatangan cookie sesi (HMAC-SHA256). Wajib 32 karakter atau lebih.
# Buat nilai acak: openssl rand -base64 48
AUTH_SECRET=

# Umur maksimum sesi admin dalam detik. Default 8 jam (satu shift kerja).
SESSION_MAX_AGE=28800

# --- Situs -----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Penyimpanan file (PRD bagian 6.3) -------------------------------------
# local = tulis ke folder di dalam image (hanya aman di VPS).
# s3    = unggah ke bucket kompatibel S3 (wajib di Vercel, filesystem ephemeral).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Diisi hanya saat STORAGE_DRIVER=s3
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
STORAGE_S3_PUBLIC_URL=

# --- Admin seed ------------------------------------------------------------
# Dipakai `bun run db:seed` untuk membuat akun admin pertama.
# Password harus minimal 8 karakter. Ganti setelah seed pertama.
SEED_ADMIN_EMAIL=admin@contoh-sehat.test
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator Demo

# --- Rate limit form publik (PRD bagian 8.5) ------------------------------
# Jumlah permintaan per jendela waktu, per alamat IP, per endpoint.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5

# --- Analytics (default off, PRD bagian 3 P4) -----------------------------
NEXT_PUBLIC_GA_ID=