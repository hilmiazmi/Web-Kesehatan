# Artefak perkakas browser otomatisasi (screenshot, log konsol).
.playwright-mcp/

# Keluaran Playwright test (trace, screenshot gagal, laporan HTML). Isinya
# artefak mesin lokal yang tidak boleh masuk repo, dan ukurannya bisa besar.
test-results/
playwright-report/

# --- Aplikasi Next.js (berada di root repo) ---
# Lihat https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.vitest/

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Kunci, sertifikat, dan kredensial sensitif
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# debug & logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (jangan pernah commit .env sungguhan)
.env*
# ...tapi template-nya ikut, karena `.env.example` adalah dokumentasi
# konfigurasi yang wajib ada di repo (lihat AGENTS.md global).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Editor & IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Backend Rust yang sudah diarsipkan (archive/rust-api/) ---
# Artefak kompilasi dan cache cargo. Tanpa baris ini, `git add -A` ikut
# meng-commit target/ yang ratusan megabyte.
/archive/rust-api/target/
**/*.rs.bk

# Penanda build paralel (scripts/kunci-build.ts). Dibuat dan dihapus
# otomatis oleh prebuild/postbuild dan test:e2e; jangan commit.
.next-build-lock
.next-e2e-lock
