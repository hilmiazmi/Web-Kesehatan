# Artefak perkakas browser otomatisasi (screenshot, log konsol).
.playwright-mcp/

# --- Aplikasi Next.js (berada di root repo) ---
# Lihat https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (jangan pernah commit .env)
.env*
# ...tapi template-nya ikut, karena `.env.example` adalah dokumentasi
# konfigurasi yang wajib ada di repo (lihat AGENTS.md global).
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Rust API (berada di api/) ---
# Artefak kompilasi dan cache cargo. Tanpa baris ini, `git add -A` ikut
# meng-commit api/target/ yang ratusan megabyte.
/api/target/
**/*.rs.bk
